# Entity: wonder

main: kit: entity: wonder: {

  alias: field: {}

  fields: {
    build_year: {
      h: "Build Year"
      n: "build_year"
      r: false
      sh: "Year the wonder was built"
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the wonder"
      t: "`$STRING`"
    }
    links: {
      h: "Links"
      n: "links"
      r: false
      t: "`$OBJECT`"
    }
    location: {
      h: "Location"
      n: "location"
      r: false
      t: "`$OBJECT`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the world wonder"
      t: "`$STRING`"
    }
    summary: {
      h: "Summary"
      n: "summary"
      r: false
      sh: "Brief summary of the wonder"
      t: "`$STRING`"
    }
    time_period: {
      h: "Time Period"
      n: "time_period"
      r: false
      sh: "Historical time period of the wonder"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "wonder"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /wonders"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 0
                k: "query"
                n: "offset"
                or: "offset"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/wonders"
          q: {
            exist: [
              "limit"
              "offset"
            ]
          }
          s: [
            {
              lit: "wonders"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /wonders/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/wonders/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "wonders"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
